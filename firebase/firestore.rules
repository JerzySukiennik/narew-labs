rules_version = '2';

// Narew Labs — Firestore.
//
// One rule runs through all of this: an account is writable only by the person
// signed into it. The single exception is the grants mailbox, and it exists
// because a referral has to pay the *referrer*, who is not the one signing in.
// Rather than opening their account, a stranger may drop one narrowly shaped
// document into it, which their own client applies and deletes.
//
// Tiers are self-assignable on purpose: there are no real payments in this
// product, the checkout says so, and pretending otherwise would need a server.

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, create, update, delete: if request.auth != null && request.auth.uid == uid;

      match /conversations/{conv} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      match /usage/{event} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }

      // The mailbox. Read and clear it yourself; anyone signed in may leave
      // exactly one kind of note in it, and nothing else.
      match /grants/{grant} {
        allow read, delete: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.resource.data.keys().hasOnly(['tier', 'days', 'from', 'at'])
          && request.resource.data.tier == 'lin'
          && request.resource.data.days == 7
          && request.resource.data.from == request.auth.uid;
      }
    }

    // Keyed by the referred user, so a referral cannot be claimed twice.
    match /referrals/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.referred == uid
        && request.resource.data.referrer is string
        && request.resource.data.referrer != uid;
    }

    // Codes are readable so the client can check one; only the console writes.
    match /promoCodes/{code} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
